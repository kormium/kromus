root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = ktlint_official
# Multiline calls and parameter lists carry a trailing comma throughout this codebase.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# The rules below are switched off where ktlint_official disagrees with how this codebase is
# already written. Formatting exists to stop arguments, not to start one: a linter that rewrites
# consistent, readable code into something longer is not earning its place.
#
# The engine deliberately packs short statements — swap bodies, heap sifts — onto one line where
# that reads better than four.
ktlint_standard_statement-wrapping = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_function-signature = disabled
# Word lists, coordinate tuples and small vectors are written several to a line on purpose; one
# argument per line turns a 3-line literal into 80.
ktlint_standard_argument-list-wrapping = disabled
# Test classes here open with a blank line, and short constructors stay on one line.
ktlint_standard_no-empty-first-line-in-class-body = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_chain-method-continuation = disabled
# Guard clauses and the `if (x) { { … } } else { { … } }` lambda idiom read better on one line.
ktlint_standard_if-else-wrapping = disabled
# Trailing comments are aligned in a few places on purpose.
ktlint_standard_no-multi-spaces = disabled
# Compact rule tables — a `when` whose branches each test a handful of suffixes — read as tables.
# One operand per line, wrapped in its own parenthesis block, turns two clear lines into eight.
ktlint_standard_condition-wrapping = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[gradle/wrapper/*]
insert_final_newline = false
